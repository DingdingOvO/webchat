<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- WebChat SpotBugs exclusion — only exclude confirmed false positives -->

  <!-- Spring Boot proxy false positives -->
  <Match>
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
  </Match>
  <Match>
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Or>
      <Field name="~.*id"/>
      <Field name="~.*Id"/>
    </Or>
  </Match>

  <!-- Lombok-generated code false positives -->
  <Match>
    <Bug pattern="NP_NONNULL_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
  </Match>
  <Match>
    <Bug pattern="URF_UNREAD_FIELD"/>
    <Class name="~.*\._.*"/>
  </Match>

  <!-- FindSecBugs: all rules ENABLED by default, only exclude specific confirmed false positives below -->
  <!-- Do NOT add blanket excludes like "SECURITY" or "MALICIOUS_CODE" -->

  <!--
    SPRING_ENDPOINT 是 FindSecBugs 的信息性规则：它只是「标记出这是一个
    对外的 Spring 端点」，用于辅助人工审计，本身不代表任何缺陷。
    本项目的端点均已通过 X-Auth-Token + AuthService 做鉴权，
    因此这里属于确认的噪音，按文件既定原则精确排除。
  -->
  <Match>
    <Bug pattern="SPRING_ENDPOINT"/>
  </Match>

  <!--
    EI_EXPOSE_REP / EI_EXPOSE_REP2：getter/setter 与构造器直接暴露可变对象的引用。
    对 JPA 实体与 DTO 而言这是有意的设计（框架需要读写这些字段），
    逐字段加防御性拷贝收益极低且会破坏 JPA 的脏检查机制。
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!--
    REC_CATCH_EXCEPTION：PMD 与 SpotBugs 都会提示「catch Exception 过宽」。
    在 WebSocket 消息处理、Redis 订阅回调这类边界处，捕获宽泛异常是
    有意为之——单条消息处理失败不应导致整个连接/订阅线程崩溃。
    这些位置均已记录 WARN/ERROR 日志。
  -->
  <Match>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>

  <!--
    CRLF_INJECTION_LOGS：FindSecBugs 判定「日志参数可能带入换行以伪造日志行」。
    以下两处均属确认的误报，共同的判定依据是：日志的格式串是编译期常量，
    唯一的变量参数是后端自造的会话键（p2p:<数字>:<数字> / group:<数字>）
    或 long 型 groupId —— 两者都不含任何用户可控的自由文本，
    结构上不可能出现 \r 或 \n。

    注意：用户可控内容的日志写入（如异常消息、WS 消息类型、Redis 频道名）
    均已在写入前经过 LogSanitizer.safe() 转义，不在此排除范围内。
  -->
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
    <Class name="com.webchat.service.ChatService"/>
  </Match>
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
    <Class name="com.webchat.service.GroupService"/>
  </Match>
</FindBugsFilter>
